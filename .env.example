# Copy to .env.local and fill in. Never commit real values. Names only here.
# Contact form: only the first two are required.

# Resend API key (a "Sending access" key is enough).
RESEND_API_KEY=
# Where messages are delivered. With the default Resend test sender this must be the email address
# your Resend account is registered with (an unverified Resend account can only send to itself).
CONTACT_TO_EMAIL=

# --- Optional ---
# Sender. Default: "LKW22 Studio Contact <onboarding@resend.dev>". Set only once a domain is verified in Resend.
# CONTACT_FROM_EMAIL=
# Signs the form timestamp. Default: derived from RESEND_API_KEY.
# CONTACT_FORM_SECRET=
# Shared rate limit across server instances. Set BOTH, or neither (neither = best-effort in-memory limit per instance).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Local development only: 1 skips Resend and the rate limit and shows the success state. Ignored in production.
# CONTACT_DRY_RUN=
