# Copy to .env.local and fill in. Never commit real values. Names only here.
# Contact form (Phase 8). In production all of these are required.

# Resend: use a "Sending access" API key.
RESEND_API_KEY=
# Where messages are delivered.
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "LKW22 Studio <contact@your-domain>".
CONTACT_FROM_EMAIL=

# Upstash Redis (REST) for the rate limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string (32+ chars). Signs the form timestamp and salts the IP hash.
CONTACT_FORM_SECRET=

# Local development only. Set to 1 to skip Resend and Redis and see the success state.
# Ignored unless NODE_ENV is "development", so it cannot take effect in production.
CONTACT_DRY_RUN=
